{
  "name": "javascript-apple-fm-sdk",
  "version": "0.1.1",
  "description": "JavaScript/TypeScript SDK for Apple's on-device Foundation Models (SystemLanguageModel)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/entry.js",
      "default": "./dist/entry.js"
    }
  },
  "files": [
    "dist",
    "build/apple_fm_sdk_napi.node",
    "build/libFoundationModels.dylib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "build:native": "./build.sh",
    "build:napi": "cd native && cargo build --release && cp target/release/libapple_fm_sdk_napi.dylib ../build/apple_fm_sdk_napi.node",
    "build:all": "bun run build:native && bun run build:napi && bun run build",
    "build:release": "bun run verify:headers && bun run build:all && bun run check && node scripts/verify-package.mjs",
    "prepack": "bun run build:release",
    "pack:check": "npm pack --dry-run",
    "check": "tsc --noEmit",
    "test": "bun test --timeout 60000",
    "test:watch": "bun test --watch --timeout 60000",
    "test:unit": "bun test --timeout 60000",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist build",
    "start": "bun run src/entry.ts",
    "start:node": "tsx src/entry.ts",
    "example": "bun run examples/simple-inference.ts",
    "example:node": "tsx examples/simple-inference.ts",
    "validate:readme": "bun run scripts/validate-readme-examples.ts",
    "validate:readme:node": "tsx scripts/validate-readme-examples.ts",
    "verify:headers": "node scripts/verify-foundation-models-headers.mjs",
    "release": "./scripts/release.sh",
    "release:yes": "./scripts/release.sh current --yes"
  },
  "keywords": [
    "apple",
    "apple-intelligence",
    "foundation-models",
    "on-device",
    "ai",
    "language-model",
    "macos",
    "ffi",
    "typescript"
  ],
  "author": "Tariq West",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tariqwest/javascript-apple-fm-sdk.git"
  },
  "homepage": "https://github.com/tariqwest/javascript-apple-fm-sdk#readme",
  "bugs": {
    "url": "https://github.com/tariqwest/javascript-apple-fm-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.8.3"
  }
}
